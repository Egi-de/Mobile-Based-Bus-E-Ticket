# ========================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and update with your local values
# DO NOT commit .env to Git - it's already in .gitignore

# Server Configuration
NODE_ENV=development
PORT=5000

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Option 1: PostgreSQL (Recommended for production parity)
# Install PostgreSQL locally: https://www.postgresql.org/download/
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL="postgresql://egide:database%40123@127.0.0.1:5432/gopass_db"

# Option 2: SQLite (Lightweight alternative for quick local development)
# Uncomment the line below and comment out the PostgreSQL line above
# DATABASE_URL="file:./dev.db"
# Note: Change datasource provider in schema.prisma to "sqlite" if using SQLite

# ========================================
# JWT SECRETS
# ========================================
# IMPORTANT: Change these in production!
# Generate strong secrets using: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_SECRET=access-token-secret-key-change-in-production
REFRESH_TOKEN_SECRET=refresh-token-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ========================================
# CORS CONFIGURATION
# ========================================
# Development: Allow localhost and local network for Expo
# Add your local IP for mobile testing (find with: ipconfig or ifconfig)
# Production: Specify exact domains (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://192.168.1.100:8081

# ========================================
# FIREBASE ADMIN SDK CONFIGURATION
# ========================================
# Get these from Firebase Console > Project Settings > Service Accounts
# Generate new private key and copy values here
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# ========================================
# CLOUDINARY CONFIGURATION
# ========================================
# Get these from Cloudinary Dashboard > Settings > Access Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


{
  "expo": {
    "name": "GoPass",
    "slug": "GoPass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gopass.png",
    "scheme": "gopass",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/gopass.png",
      "resizeMode": "contain",
      "backgroundColor": "#121420"
    },
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/images/gopass.png",
        "resizeMode": "contain",
        "backgroundColor": "#121420"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gopass.png",
        "backgroundColor": "#121420",
        "monochromeImage": "./assets/images/gopass.png"
      },
      "splash": {
        "image": "./assets/images/gopass.png",
        "resizeMode": "contain",
        "backgroundColor": "#121420"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.egidev.GoPass"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/gopass.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/gopass.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121420"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "33354bf1-beed-4df2-835c-bc5057d00be5"
      }
    }
  }
}
